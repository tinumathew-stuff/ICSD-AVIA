module data_access(
  input clk,
  input [63:0] isa,
  output reg [7:0] out
);

  reg [7:0] reg_a [127:0];
  reg [7:0] reg_b [127:0];
  reg [7:0] reg_c [127:0];

  reg [7:0] temp;

  always @(posedge clk) begin
    case (isa[1:0])
      2'b00: temp = reg_a[isa[8:2]];
      2'b01: temp = reg_b[isa[8:2]];
      2'b10: temp = reg_c[isa[8:2]];
      default: temp = 8'b0;
    endcase

    if (isa[63] == 1'b1) begin
      out <= temp;
    end else begin
      out <= {7'b0, temp[isa[22:17]]};      
    end
  end
endmodule
